# Copy to .env.local (git-ignored) and fill in.
SPOOL_ARCHIVE=/Volumes/MAIN/000 FILM 2.0
SPOOL_DATA=./data
SPOOL_RESCAN_MINUTES=10

# Private view — disabled unless BOTH are set.
# The unlock page lives at /<SPOOL_UNLOCK_PATH>; nothing links to it.
SPOOL_UNLOCK_PATH=
SPOOL_PASSWORD=

# Privacy backups are written here on every change (keep it outside the archive; git-ignored).
SPOOL_BACKUP_DIR=./backups
# 1 = there must always be private markings; if none are found, guests see nothing (fresh-install safety).
SPOOL_PRIVACY_REQUIRED=
