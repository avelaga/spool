{
  "name": "spool",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=23.6"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "index": "node --disable-warning=ExperimentalWarning scripts/index.ts",
    "review": "node --disable-warning=ExperimentalWarning scripts/review.ts",
